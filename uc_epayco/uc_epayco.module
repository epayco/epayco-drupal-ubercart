/**
 * Implements hook_menu().
 */

//Este enlace permite a los módulos registrar rutas para definir cómo se manejan las solicitudes de URL.
function uc_epayco_menu() {
  $items['cart/uc_epayco/confirmation'] = array(
    'title' => 'ePayco Confirmation Page',
    'page callback' => '_uc_epayco_confirmation_page',
    'access callback' => '_uc_epayco_access_confirmation_page',
    'type' => MENU_CALLBACK,
    'file' => 'uc_epayco.pages.inc',
  );
  $items['cart/uc_epayco/response'] = array(
    'title' => 'ePayco Response Page',
    'page callback' => '_uc_epayco_response_page',
    'access callback' => '_uc_epayco_access_response_page',
    'type' => MENU_CALLBACK,
    'file' => 'uc_epayco.pages.inc',
  );
   $items['cart/uc_epayco/checkout'] = array(
    'title' => 'ePayco checkout Page',
    'page callback' => '_uc_epayco_checkout_page',
    'access callback' => '_uc_epayco_access_checkout_page',
    'type' => MENU_CALLBACK,
    'file' => 'uc_epayco.pages.inc',
  );

  return $items;
}

/**
 * Implements hook_form_alter().
 */

//Permita que los módulos interactúen con el core de Drupal.

/*
$form:Matriz anidada de elementos de formulario que comprenden el formulario..
$form_state: Una matriz con clave que contiene el estado actual del formulario.
$form_id:cadena que representa el nombre del formulario en sí. Normalmente, este es el nombre de la función que generó el formulario.
*/
function uc_epayco_form_alter(&$form, &$form_state, $form_id) {
  if ($form_id == 'uc_cart_checkout_review_form' && ($order_id = intval($_SESSION['cart_order'])) > 0) {
    global $language;
    global $user;
    $order = uc_order_load($order_id);

    // Depuración: imprimir estructura de orden Ubercart antes de montar el checkout
    if ($order) {
      error_log('[ePayco] Ubercart order data: ' . print_r($order, TRUE));
    } else {
      error_log('[ePayco] Ubercart order not found for order_id ' . $order_id);
    }

    if ($order->payment_method == 'epayco') {

      $bearer_token = uc_epayco_get_bearer_token();
      $headers = array(
        'Authorization: Basic ' . $bearer_token
      );

      $token_response = uc_epayco_realizar_llamada_api("login", array(), $headers);
      
      $session_token = '';
      if ($token_response && isset($token_response['token']) && !empty($token_response['token'])) {
        $session_token = $token_response['token'];
      }

      $reference_code = uc_epayco_get_reference($order_id);
      $amount = uc_epayco_format_amount($order->order_total);
      $currency = uc_epayco_get_currency();

        switch (intval($order->delivery_country)) {
          case 840:
              $country="US";
            break;
          case 124:
              $country="CA";
            break;
          default:
             $country="CO";
            break;
        }

      $iva_tax_id = uc_epayco_get_iva_tax_id();
      $tax = 0;
      $base_tax = 0;
      $tax_is_ico = FALSE;
      $tax_rate_name = '';
      $selected_tax_id = uc_epayco_get_ico_tax_id();

      // Detectar si el impuesto seleccionado es ICO
      if ($selected_tax_id && module_exists('uc_taxes')) {
        $tax_rate = uc_taxes_rate_load($selected_tax_id);
        if ($tax_rate && isset($tax_rate->name)) {
          $tax_rate_name = strtolower($tax_rate->name);
          if (strpos($tax_rate_name, 'ico') !== FALSE) {
            $tax_is_ico = TRUE;
          }
        }
      }

      //Remover los items de impuesto que NO correspondan al seleccionado, solo mantener el impuesto (tax item) que coincida con $selected_tax_id
      if (!empty($order->line_items) && is_array($order->line_items) && $selected_tax_id > 0) {
        error_log('[ePayco] Iniciando purga de impuestos no seleccionados. Selected tax ID: ' . $selected_tax_id);
        
        $new_line_items = array();
        $removed_tax_items = array();
        
        foreach ($order->line_items as $key => $line_item) {
          $line_type = uc_epayco_get_line_item_value($line_item, 'type', '');
          $line_tax_id = uc_epayco_get_line_item_data($line_item, 'tax_id', NULL);
          
          // Si es un item de impuesto (tax)
          if ($line_type === 'tax') {
            // Si el tax_id NO coincide con el seleccionado, NO lo incluimos
            if ($line_tax_id != $selected_tax_id) {
              $removed_tax_items[] = $line_item;
              continue;
            } 
          }
          
          // Incluir todos los items, impuestos seleccionados
          $new_line_items[$key] = $line_item;
        }
        
        // Reemplazar los line_items de la orden
        if (count($removed_tax_items) > 0) {
          $order->line_items = $new_line_items;
          
          // Recalcular totales de la orden
          uc_order_save($order);
        
        }
      }

      // Recalcular tax basado en los line_items actualizados
      if ($tax_is_ico) {
        $tax = uc_epayco_get_ico($order);
      }
      elseif (isset($order->tax) && floatval($order->tax) > 0) {
        $tax = floatval($order->tax);
      }

      if ($tax <= 0 && !empty($selected_tax_id) && !empty($order->line_items) && is_array($order->line_items)) {
        foreach ($order->line_items as $line_item) {
          $line_name = strtolower((string) uc_epayco_get_line_item_value($line_item, 'name', ''));
          $line_type = strtolower((string) uc_epayco_get_line_item_value($line_item, 'type', ''));
          $line_amount = floatval(uc_epayco_get_line_item_value($line_item, 'amount', 0));
          $line_tax_id = uc_epayco_get_line_item_data($line_item, 'tax_id', NULL);
          $line_taxable_amount = uc_epayco_get_line_item_data($line_item, 'taxable_amount', NULL);

          if ($line_tax_id == $selected_tax_id) {
            $tax += $line_amount;
            if ($line_taxable_amount !== NULL) {
              $base_tax += floatval($line_taxable_amount);
            }
          }
        }
      }

      if ($tax <= 0 && !empty($order->order_total) && !empty($order->order_subtotal)) {
        $tax = floatval($order->order_total) - floatval($order->order_subtotal);
      }

      if ($tax <= 0 && !empty($order->subtotal) && !empty($order->order_total)) {
        $tax = floatval($order->order_total) - floatval($order->subtotal);
      }

      if ($tax <= 0 && !empty($order->line_items) && is_array($order->line_items)) {
        foreach ($order->line_items as $line_item) {
          $line_name = strtolower((string) uc_epayco_get_line_item_value($line_item, 'name', ''));
          $line_type = strtolower((string) uc_epayco_get_line_item_value($line_item, 'type', ''));
          $line_amount = floatval(uc_epayco_get_line_item_value($line_item, 'amount', 0));
          $line_tax_id = uc_epayco_get_line_item_data($line_item, 'tax_id', NULL);
          if (strpos($line_name, 'tax') !== FALSE || strpos($line_type, 'tax') !== FALSE || strpos($line_name, 'iva') !== FALSE || strpos($line_type, 'iva') !== FALSE || strpos($line_name, 'ico') !== FALSE || strpos($line_type, 'ico') !== FALSE) {
            $tax += $line_amount;
          }
        }
      }

      if ($tax > 0 && $base_tax <= 0) {
        $base_tax = floatval($amount) - $tax;
      }
      if ($tax <= 0) {
        $base_tax = floatval($amount);
      }

      $tax_field = $tax_is_ico ? 0 : $tax;
      $tax_ico_field = $tax_is_ico ? $tax : 0;


      $description = array();
      $qty = 0;
      foreach ($order->products as $item) {
        $description[] = $item->qty . " x " . $item->title;
        $qty += $item->qty;
      }
      $description = format_plural($qty, t("1 product"), t("@count products")) . ': ' . implode("; ", $description);

      if (mb_strlen($description) > 250) {
        $description = mb_substr($description, 0, 246) . ' ...';
      }

      $extra3 = array(
        'uid' => $user->uid,
        'order_id' => $order_id,
        'cart_id' => uc_cart_get_id(FALSE),
        'token_id' => session_id(),
      );

      $checkout_data = array(
        'epayco_token' => $session_token,
        'amount' => $amount,
        'tax' => $tax_field,
        'taxIco' => $tax_ico_field,
        'base_tax' => $base_tax,
        'currency' => $currency,
        'email' => $order->primary_email,
        'firstname' => $order->billing_first_name . " " . $order->billing_last_name,
        'reference' => $reference_code,
        'lang_checkout' => uc_epayco_get_language(),
        'checkout_external' => uc_epayco_get_type_checkout(),
        'test' => uc_epayco_get_txn_type(),
        'notify_url' => url('cart/uc_epayco/confirmation', array('absolute' => TRUE)),
        'return_url' => url('cart/uc_epayco/response', array('absolute' => TRUE)),
        'extra2' => uc_cart_get_id(FALSE),
        'extra3' => session_id(),
        'extra4' => $order_id,
        'address' => $order->billing_street1,
        'ip' => uc_epayco_ip(),
        'country' => $country,
        'description' => isset($item->title) ? $item->title : $description,
      );

      foreach ($checkout_data as $key => $value) {
        $form[$key] = array(
          '#type' => 'hidden',
          '#value' => $value,
        );
      }
      
      $form['#suffix'] = '<script src="https://epayco-checkout-testing.s3.amazonaws.com/checkout.preprod-v2.js"></script>
                         <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>';

      $form['#action'] = url('cart/uc_epayco/checkout', array('absolute' => TRUE));
       $form['actions']['submit'] = array(
         '#type' => 'submit',
         '#value' => t('Submit order'),
       );

    }
  }

}




