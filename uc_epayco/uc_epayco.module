function uc_epayco_get_reference($order_id) {
  return uc_epayco_get_reference_prefix() . ' - ' . $order_id . (!uc_epayco_get_txn_type() ? ' - ' . t('Test') : '');
}

function uc_epayco_get_line_item_value($line_item, $key, $default = NULL) {
  if (is_array($line_item) && array_key_exists($key, $line_item)) {
    return $line_item[$key];
  }
  if (is_object($line_item) && property_exists($line_item, $key)) {
    return $line_item->$key;
  }
  return $default;
}

function uc_epayco_get_line_item_data($line_item, $key, $default = NULL) {
  $data = uc_epayco_get_line_item_value($line_item, 'data');
  if (is_array($data) && array_key_exists($key, $data)) {
    return $data[$key];
  }
  if (is_object($data) && property_exists($data, $key)) {
    return $data->$key;
  }
  return $default;
}

function uc_epayco_get_iva($order) {
  $iva_tax_id = uc_epayco_get_iva_tax_id();

  if (!$iva_tax_id) {
    return 0;
  }

  $iva = 0;
  foreach ($order->line_items as $item) {
    if ($item['data']['tax_id'] == $iva_tax_id) {
      $iva += $item['amount'];
    }
  }

  return $iva;
}


function uc_epayco_get_ico($order) {
  $ico_tax_id = uc_epayco_get_ico_tax_id();

  if (!$ico_tax_id) {
    return 0;
  }

  $ico_tax = 0;
  foreach ($order->line_items as $item) {
    $line_tax_id = uc_epayco_get_line_item_data($item, 'tax_id', NULL);
    if ($line_tax_id == $ico_tax_id) {
      $line_amount = floatval(uc_epayco_get_line_item_value($item, 'amount', 0));
      $ico_tax += $line_amount;
    }
  }

  return $ico_tax;
}


function uc_epayco_get_base($order) {
  $iva_tax_id = uc_epayco_get_iva_tax_id();

  if (!$iva_tax_id) {
    return 0;
  }

  $base = 0;
  foreach ($order->line_items as $item) {
    if ($item['data']['tax_id'] == $iva_tax_id) {
      $base += $item['data']['taxable_amount'];
    }
  }

  return $base;
}

function uc_epayco_get_signature($reference_code, $amount, $currency, $txn_state = NULL) {
  $api_key = uc_epayco_get_api_key();
  $merchant_id = uc_epayco_get_merchant_id();

  if (!is_null($txn_state)) {
    // In confirmation page, there should only be 1 decimal if the second one is 0.
    $amount10 = $amount * 10;
    $amount10int = (integer) $amount10;
    if ($amount10 == $amount10int) {
      $decimals = 1;
    }
    else {
      $decimals = 2;
    }
    $amount = number_format($amount, $decimals, '.', '');

    // Fix an bug generated when a website doesn't use a reference prefix.
    // See https://www.drupal.org/node/2551547
    $reference_prefix = uc_epayco_get_reference_prefix();
    if (empty($reference_prefix)) {
      $reference_code = " " . $reference_code;
    }
  }


  $text =   $merchant_id .'^'.$api_key.'^'.$reference_code.'^'.$amount.'^'.$currency;
  if (!is_null($txn_state)) {
    $text .= "~$txn_state";
  }

  return md5($text);
}

function uc_epayco_format_amount($value) {
  return number_format($value, 2, '.', '');
}

function uc_epayco_format_price($value) {
  $variables = array(
    'price' => $value
  );
  return theme('uc_price', $variables);
}

function _uc_epayco_access_confirmation_page() {
  return TRUE;
}

function _uc_epayco_access_response_page() {
  return TRUE;
}

function _uc_epayco_access_checkout_page() {
  return TRUE;
}
function _uc_epayco_set_extra3(&$extra3, $index, $value) {
  $extra3[$index] = $value;
}

function _uc_epayco_get_extra3($extra3, $index, $value) {
  $extra3 = explode('-', $extra3);
  return $extra3[$index];
}

function uc_epayco_currencies($key = NULL) {
  $list = array(
    'COP' => t('Colombian Peso'),
    'USD' => t('US Dollar'),
  );
  if (!is_null($key)) {
    return _uc_epayco_list_key($list, $key);
  }
  asort($list);
  return $list;
}

function uc_epayco_languages($key = NULL) {
  $list = array(
    'EN' => t('English'),
    'ES' => t('Spanish'),
  );

  if (!is_null($key)) {
    return _uc_epayco_list_key($list, $key);
  }

  return $list;
}


function uc_epayco_ip() {
  $ipaddress = '';
  if (isset($_SERVER['HTTP_CLIENT_IP']))
      $ipaddress = $_SERVER['HTTP_CLIENT_IP'];
  else if(isset($_SERVER['HTTP_X_FORWARDED_FOR']))
      $ipaddress = $_SERVER['HTTP_X_FORWARDED_FOR'];
  else if(isset($_SERVER['HTTP_X_FORWARDED']))
      $ipaddress = $_SERVER['HTTP_X_FORWARDED'];
  else if(isset($_SERVER['HTTP_X_CLUSTER_CLIENT_IP']))
      $ipaddress = $_SERVER['HTTP_X_CLUSTER_CLIENT_IP'];
  else if(isset($_SERVER['HTTP_FORWARDED_FOR']))
      $ipaddress = $_SERVER['HTTP_FORWARDED_FOR'];
  else if(isset($_SERVER['HTTP_FORWARDED']))
      $ipaddress = $_SERVER['HTTP_FORWARDED'];
  else if(isset($_SERVER['REMOTE_ADDR']))
      $ipaddress = $_SERVER['REMOTE_ADDR'];
  else
      $ipaddress = 'UNKNOWN';
  return $ipaddress;
}

/**
 * Obtiene el Bearer Token de ePayco
 */
function uc_epayco_get_bearer_token() {
  $public_key = uc_epayco_get_api_key();
  $private_key = uc_epayco_get_private_key();
  $publicKey_cookie = 'epayco_bearer_' . md5($public_key);

  if (!isset($_COOKIE[$publicKey_cookie])) {
    $token = base64_encode($public_key . ":" . $private_key);
    setcookie($publicKey_cookie, $token, time() + (60 * 14), "/");
    $bearer_token = $token;
  } else {
    $bearer_token = $_COOKIE[$publicKey_cookie];
  }

  return $bearer_token;
}

/**
 * Restaura el inventario para transacciones rechazadas
 * @param $order Objeto de la orden
 */
function uc_epayco_restore_stock($order) {
  if (!$order || empty($order->products)) {
    watchdog('uc_epayco', 'ERROR: No hay orden o productos para restaurar stock', array(), WATCHDOG_ERROR);
    return FALSE;
  }
  
  $uc_stock_enabled = module_exists('uc_stock');
  
  if (!$uc_stock_enabled) {
    watchdog('uc_epayco', 'ADVERTENCIA: Módulo uc_stock no está activo. Intentando restaurar stock desde BD.', array(), WATCHDOG_WARNING);
  }
  
  foreach ($order->products as $product) {
    if (isset($product->nid) && isset($product->qty)) {
      $stock_before = NULL;
      $stock_after = NULL;
      
      // Intentar con uc_stock si está habilitado
      if ($uc_stock_enabled && function_exists('uc_stock_level')) {
        $stock_before = uc_stock_level($product->nid);
        
        if ($stock_before !== FALSE && $stock_before !== NULL) {
          $adjust_result = uc_stock_adjust($product->nid, $product->qty);
          $stock_after = uc_stock_level($product->nid);
        }
      }
      
      // Si no funcionó con uc_stock o no está disponible, intentar desde BD
      if ($stock_before === FALSE || $stock_before === NULL) {
        $table_exists = db_table_exists('uc_product_stock');
        
        if ($table_exists) {
          // Obtener stock ANTES
          $stock_before = db_query(
            "SELECT active FROM {uc_product_stock} WHERE nid = :nid",
            array(':nid' => $product->nid)
          )->fetchField();
          
          if ($stock_before === FALSE) {
            $stock_before = 0;
          }
          
          // Restaurar en BD
          $new_stock = $stock_before + $product->qty;
          
          $update = db_update('uc_product_stock')
            ->fields(array('active' => $new_stock))
            ->condition('nid', $product->nid)
            ->execute();
          
          if ($update == 0) {
            try {
              db_insert('uc_product_stock')
                ->fields(array(
                  'nid' => $product->nid,
                  'active' => $product->qty,
                ))
                ->execute();
              $stock_after = $product->qty;
            } catch (Exception $e) {
              watchdog('uc_epayco', 'Error al insertar stock en BD: @error', array('@error' => $e->getMessage()), WATCHDOG_ERROR);
            }
          } else {
            $stock_after = db_query(
              "SELECT active FROM {uc_product_stock} WHERE nid = :nid",
              array(':nid' => $product->nid)
            )->fetchField();
          }
        } else {
          watchdog('uc_epayco', 'ERROR: Tabla uc_product_stock no existe en BD para restaurar stock del NID @nid', 
            array('@nid' => $product->nid), WATCHDOG_ERROR);
        }
      }
      
      // Verificar si la restauración fue exitosa
      if ($stock_after !== NULL && is_numeric($stock_before) && is_numeric($stock_after)) {
        if ($stock_after > $stock_before) {
          watchdog('uc_epayco', '@title (NID @nid) | Stock restaurado de @before a @after | Orden #@order_id', 
            array('@title' => $product->title, '@nid' => $product->nid, '@before' => $stock_before, '@after' => $stock_after, '@order_id' => $order->order_id), WATCHDOG_NOTICE);
        } else {
          watchdog('uc_epayco', '@title (NID @nid) | Advertencia: Stock no cambió como se esperaba (ANTES: @before, DESPUÉS: @after) | Orden #@order_id', 
            array('@title' => $product->title, '@nid' => $product->nid, '@before' => $stock_before, '@after' => $stock_after, '@order_id' => $order->order_id), WATCHDOG_WARNING);
        }
      } else {
        watchdog('uc_epayco', '@title (NID @nid) | No se pudo validar la restauración. Antes: @before, Después: @after | Orden #@order_id', 
          array('@title' => $product->title, '@nid' => $product->nid, '@before' => ($stock_before !== NULL ? $stock_before : 'NULL'), '@after' => ($stock_after !== NULL ? $stock_after : 'NULL'), '@order_id' => $order->order_id), WATCHDOG_WARNING);
      }
    }
  }
  
  return TRUE;
}

/**
 * Realiza una llamada a la API de ePayco usando cURL
 */
function uc_epayco_realizar_llamada_api($path, $data = array(), $headers = array(), $method = 'POST') {
  $url = 'https://eks-apify-service.epayco.io/' . $path;

  $ch = curl_init();
  curl_setopt($ch, CURLOPT_URL, $url);
  curl_setopt($ch, CURLOPT_RETURNTRANSFER, TRUE);
  curl_setopt($ch, CURLOPT_TIMEOUT, 15);
  curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, FALSE);

  if ($method === 'POST') {
    curl_setopt($ch, CURLOPT_POST, TRUE);
    curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
  }

  $default_headers = array(
    'Content-Type: application/json',
  );

  if (!empty($headers)) {
    $default_headers = array_merge($default_headers, $headers);
  }

  curl_setopt($ch, CURLOPT_HTTPHEADER, $default_headers);

  $response = curl_exec($ch);
  $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
  $curl_error = curl_error($ch);
  curl_close($ch);



  if (!empty($curl_error)) {
    watchdog('uc_epayco', 'Error en llamada a API: @error', array('@error' => $curl_error), WATCHDOG_ERROR);
    return FALSE;
  }

  if ($http_code == 200) {
    $response_data = json_decode($response, TRUE);
    return $response_data;
  } else {
    watchdog('uc_epayco', 'Error en respuesta de API. Código: @code, Respuesta: @response', 
      array('@code' => $http_code, '@response' => $response), WATCHDOG_WARNING);
    return FALSE;
  }
}
